{
  "name": "profile-introdution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,md,json,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,md,json,html}\"",
    "check": "npm run lint && npm run format:check && npm run build",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.0",
    "vite": "^5.4.21"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json,html}": [
      "prettier --check"
    ]
  }
}
